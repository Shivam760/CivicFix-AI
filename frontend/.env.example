# Copy to frontend/.env (gitignored) and change if the backend runs elsewhere.
# Only variables starting with VITE_ reach the browser, so never put secrets here.
VITE_API_BASE_URL=http://localhost:8000

# Maps and address search (src/services/mapConfig.js).
# Empty = OpenStreetMap + Nominatim (free, no key; search on Enter only).
# A Geoapify key = search-as-you-type, better addresses, styled light/dark maps.
# Get a free key at https://myprojects.geoapify.com and, in its settings, allow
# only your site (e.g. http://localhost:5173), because the browser can see it.
VITE_GEOAPIFY_API_KEY=
# Set to "osm" to switch back to OpenStreetMap while keeping the key above.
VITE_MAP_PROVIDER=
